# =========================================================\
# v9 
\f5 \'be\'c8\'c1\'a4\'c8\'ad
\f3  
\f5 \'b9\'f6\'c0\'fc
\f3  (Colab Python3.12 / CatBoost 
\f5 \'bf\'c0\'b7\'f9
\f3  
\f5 \'c7\'d8\'b0\'e1\'c6\'c7
\f3 )\
# 
\f5 \'b1\'d7\'b4\'eb\'b7\'ce
\f3  
\f5 \'bd\'c7\'c7\'e0\'c7\'cf\'b8\'e9
\f3  
\f5 \'b5\'ca
\f3 \
# =========================================================\
\
# 
\f5 \'c7\'ca\'bc\'f6
\f3  
\f5 \'b6\'f3\'c0\'cc\'ba\'ea\'b7\'af\'b8\'ae
\f3  
\f5 \'bc\'b3\'c4\'a1
\f3 \
!pip install -q lightgbm==4.3.0 xgboost==2.0.3 catboost scipy optuna\
\
# ---------------------------------------------------------\
# 
\f5 \'b1\'e2\'ba\'bb
\f3  
\f5 \'b6\'f3\'c0\'cc\'ba\'ea\'b7\'af\'b8\'ae
\f3 \
# ---------------------------------------------------------\
import os\
import gc\
import time\
import warnings\
from pathlib import Path\
\
import numpy as np\
import pandas as pd\
\
from sklearn.model_selection import StratifiedKFold\
from sklearn.metrics import roc_auc_score\
\
import lightgbm as lgb\
import xgboost as xgb\
from catboost import CatBoostClassifier, Pool\
\
from scipy.optimize import minimize\
\
warnings.filterwarnings("ignore")\
\
print("NumPy     :", np.__version__)\
print("LightGBM  :", lgb.__version__)\
print("XGBoost   :", xgb.__version__)\
print("CatBoost  : OK")\
\
# =========================================================\
# 
\f5 \'b5\'a5\'c0\'cc\'c5\'cd
\f3  
\f5 \'b7\'ce\'b5\'e5
\f3 \
# =========================================================\
train = pd.read_csv("/content/train.csv")\
test  = pd.read_csv("/content/test.csv")\
sample_submission = pd.read_csv("/content/sample_submission.csv")\
\
TARGET = "target"\
ID_COL = "ID"\
\
X = train.drop(columns=[TARGET, ID_COL], errors="ignore")\
y = train[TARGET]\
\
X_test = test.drop(columns=[ID_COL], errors="ignore")\
\
print("Train shape:", X.shape)\
print("Test shape :", X_test.shape)\
\
# =========================================================\
# Stratified KFold\
# =========================================================\
N_SPLITS = 5\
skf = StratifiedKFold(\
    n_splits=N_SPLITS,\
    shuffle=True,\
    random_state=42\
)\
\
# =========================================================\
# 
\f5 \'c0\'fa\'c0\'e5\'bf\'eb
\f3  
\f5 \'b9\'e8\'bf\'ad
\f3 \
# =========================================================\
oof_lgb = np.zeros(len(X))\
oof_xgb = np.zeros(len(X))\
oof_cat = np.zeros(len(X))\
\
pred_lgb = np.zeros(len(X_test))\
pred_xgb = np.zeros(len(X_test))\
pred_cat = np.zeros(len(X_test))\
\
# =========================================================\
# Fold 
\f5 \'c7\'d0\'bd\'c0
\f3 \
# =========================================================\
for fold, (tr_idx, va_idx) in enumerate(skf.split(X, y), 1):\
\
    print(f"\\n========== Fold \{fold\} ==========")\
\
    X_train, X_valid = X.iloc[tr_idx], X.iloc[va_idx]\
    y_train, y_valid = y.iloc[tr_idx], y.iloc[va_idx]\
\
    # -----------------------------------------------------\
    # LightGBM\
    # -----------------------------------------------------\
    lgb_model = lgb.LGBMClassifier(\
        n_estimators=1200,\
        learning_rate=0.03,\
        max_depth=6,\
        num_leaves=31,\
        subsample=0.85,\
        colsample_bytree=0.85,\
        reg_alpha=0.3,\
        reg_lambda=1.0,\
        random_state=42\
    )\
\
    lgb_model.fit(\
        X_train, y_train,\
        eval_set=[(X_valid, y_valid)],\
        eval_metric="auc",\
        callbacks=[lgb.early_stopping(100, verbose=False)]\
    )\
\
    oof_lgb[va_idx] = lgb_model.predict_proba(X_valid)[:, 1]\
    pred_lgb += lgb_model.predict_proba(X_test)[:, 1] / N_SPLITS\
\
    # -----------------------------------------------------\
    # XGBoost\
    # -----------------------------------------------------\
    xgb_model = xgb.XGBClassifier(\
        n_estimators=1200,\
        learning_rate=0.03,\
        max_depth=6,\
        subsample=0.85,\
        colsample_bytree=0.85,\
        reg_alpha=0.3,\
        reg_lambda=1.0,\
        random_state=42,\
        eval_metric="auc",\
        tree_method="hist"\
    )\
\
    xgb_model.fit(\
        X_train, y_train,\
        eval_set=[(X_valid, y_valid)],\
        verbose=False\
    )\
\
    oof_xgb[va_idx] = xgb_model.predict_proba(X_valid)[:, 1]\
    pred_xgb += xgb_model.predict_proba(X_test)[:, 1] / N_SPLITS\
\
    # -----------------------------------------------------\
    # CatBoost (
\f5 \'bf\'c0\'b7\'f9
\f3  
\f5 \'be\'f8\'b4\'c2
\f3  
\f5 \'c3\'d6\'bd\'c5\'b9\'f6\'c0\'fc
\f3  
\f5 \'b4\'eb\'c0\'c0
\f3 )\
    # -----------------------------------------------------\
    cat_model = CatBoostClassifier(\
        iterations=1200,\
        learning_rate=0.03,\
        depth=6,\
        loss_function="Logloss",\
        eval_metric="AUC",\
        random_seed=42,\
        verbose=0\
    )\
\
    cat_model.fit(\
        X_train, y_train,\
        eval_set=(X_valid, y_valid),\
        use_best_model=True\
    )\
\
    oof_cat[va_idx] = cat_model.predict_proba(X_valid)[:, 1]\
    pred_cat += cat_model.predict_proba(X_test)[:, 1] / N_SPLITS\
\
    gc.collect()\
\
# =========================================================\
# 
\f5 \'b0\'b3\'ba\'b0
\f3  
\f5 \'c1\'a1\'bc\'f6
\f3 \
# =========================================================\
score_lgb = roc_auc_score(y, oof_lgb)\
score_xgb = roc_auc_score(y, oof_xgb)\
score_cat = roc_auc_score(y, oof_cat)\
\
print("\\n==============================")\
print("LGB AUC :", score_lgb)\
print("XGB AUC :", score_xgb)\
print("CAT AUC :", score_cat)\
\
# =========================================================\
# 
\f5 \'be\'d3\'bb\'f3\'ba\'ed
\f3  
\f5 \'c3\'d6\'c0\'fb\'c8\'ad
\f3 \
# =========================================================\
oof_stack = np.vstack([oof_lgb, oof_xgb, oof_cat]).T\
\
def objective(w):\
    w = np.array(w)\
    w = w / w.sum()\
    pred = np.dot(oof_stack, w)\
    return -roc_auc_score(y, pred)\
\
init_w = [1/3, 1/3, 1/3]\
\
result = minimize(\
    objective,\
    init_w,\
    method="Nelder-Mead"\
)\
\
best_w = result.x / result.x.sum()\
\
print("\\nBest Weights:")\
print("LGB :", best_w[0])\
print("XGB :", best_w[1])\
print("CAT :", best_w[2])\
\
# =========================================================\
# 
\f5 \'c3\'d6\'c1\'be
\f3  
\f5 \'c1\'a6\'c3\'e2\'c6\'c4\'c0\'cf
\f3 \
# =========================================================\
final_pred = (\
    pred_lgb * best_w[0] +\
    pred_xgb * best_w[1] +\
    pred_cat * best_w[2]\
)\
\
sample_submission[TARGET] = final_pred\
sample_submission.to_csv("submission_v9_fixed.csv", index=False)\
\
print("\\nsubmission_v9_fixed.csv 
\f5 \'c0\'fa\'c0\'e5
\f3  
\f5 \'bf\'cf\'b7\'e1
\f3 ")\
\
