# f1 score loss\
def f1_loss(self, y_pred, y_true):\
    tp = torch.sum(torch.tensor(y_true*y_pred).float(), 0)\
    tn = torch.sum(torch.tensor((1-y_true)*(1-y_pred)).float(), 0)\
    fp = torch.sum(torch.tensor((1-y_true)*y_pred).float(), 0)\
    fn = torch.sum(torch.tensor(y_true*(1-y_pred)).float(), 0)\
\
    p = tp/(tp+fp +1e-7)\
    r = tp/(tp+fn+ 1e-7)\
\
    f1 = 2*p*r / (p+r+1e-7)\
    f1 = torch.where(torch.isnan(f1), torch.zeros_like(f1), f1)\
    return 1-torch.mean(f1)\
