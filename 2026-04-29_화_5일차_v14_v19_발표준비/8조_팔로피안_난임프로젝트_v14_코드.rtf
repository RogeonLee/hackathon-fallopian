\f0\fs24 \cf0 import pandas as pd\
import numpy as np\
from sklearn.model_selection import StratifiedKFold\
from lightgbm import LGBMClassifier\
\
# =========================\
# 1. \uc0\u45936 \u51060 \u53552  \u47196 \u46300 \
# =========================\
train = pd.read_csv("train.csv")\
test = pd.read_csv("test.csv")\
\
target = "\uc0\u51076 \u49888  \u49457 \u44277  \u50668 \u48512 "\
\
# =========================\
# 2. \uc0\u44592 \u48376  \u51204 \u52376 \u47532 \
# =========================\
def preprocess(df):\
    df = df.copy()\
\
    # \uc0\u45208 \u51060  \u49688 \u52824 \u54868 \
    if "\uc0\u49884 \u49696  \u45817 \u49884  \u45208 \u51060 " in df.columns:\
        df["age_num"] = df["\uc0\u49884 \u49696  \u45817 \u49884  \u45208 \u51060 "].str.extract(r'(\\d+)').astype(float)\
\
    # \uc0\u44208 \u52769  \u50976 \u51648  + \u51068 \u48512  flag\
    for col in df.columns:\
        if df[col].isnull().sum() > 0:\
            df[col + "_isnull"] = df[col].isnull().astype(int)\
\
    return df\
\
train = preprocess(train)\
test = preprocess(test)\
\
features = [c for c in train.columns if c not in [target, "ID"]]\
\
X = train[features]\
y = train[target]\
X_test = test[features]\
\
# =========================\
# 3. \uc0\u47784 \u45944  \u45796 \u50577 \u49457  \u44396 \u49457 \
# =========================\
\
models = []\
\
# Model 1: \uc0\u44592 \u48376 \
models.append(LGBMClassifier(\
    n_estimators=2000,\
    learning_rate=0.03,\
    num_leaves=63,\
    subsample=0.8,\
    colsample_bytree=0.8,\
    random_state=42\
))\
\
# Model 2: shallow (regularization \uc0\u44053 \u54868 )\
models.append(LGBMClassifier(\
    n_estimators=2000,\
    learning_rate=0.03,\
    num_leaves=31,\
    min_child_samples=200,\
    subsample=0.7,\
    colsample_bytree=0.7,\
    random_state=2024\
))\
\
# Model 3: deep (\uc0\u48373 \u51105 \u54620  \u44396 \u51312 )\
models.append(LGBMClassifier(\
    n_estimators=2000,\
    learning_rate=0.02,\
    num_leaves=95,\
    subsample=0.9,\
    colsample_bytree=0.9,\
    random_state=777\
))\
\
# =========================\
# 4. CV + Multi-seed\
# =========================\
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\
\
oof_preds = np.zeros(len(X))\
test_preds = np.zeros(len(X_test))\
\
for model in models:\
    print(f"\\nTraining model: \{model\}")\
\
    fold_test_preds = np.zeros(len(X_test))\
\
    for fold, (train_idx, val_idx) in enumerate(skf.split(X, y)):\
        print(f"Fold \{fold\}")\
\
        X_train, X_val = X.iloc[train_idx], X.iloc[val_idx]\
        y_train, y_val = y.iloc[train_idx], y.iloc[val_idx]\
\
        model.fit(\
            X_train, y_train,\
            eval_set=[(X_val, y_val)],\
            eval_metric="auc",\
            callbacks=[]\
        )\
\
        oof_preds[val_idx] += model.predict_proba(X_val)[:, 1] / len(models)\
        fold_test_preds += model.predict_proba(X_test)[:, 1] / skf.n_splits\
\
    test_preds += fold_test_preds / len(models)\
\
# =========================\
# 5. Rank Averaging \uc0\u52628 \u44032 \
# =========================\
rank_preds = pd.Series(test_preds).rank() / len(test_preds)\
\
final_preds = (test_preds + rank_preds) / 2\
\
# =========================\
# 6. \uc0\u51228 \u52636  \u54028 \u51068  \u49373 \u49457 \
# =========================\
submission = pd.DataFrame(\{\
    "ID": test["ID"],\
    "probability": final_preds\
\})\
\
submission.to_csv("v15_submission.csv", index=False)\
\
print("\uc0\u50756 \u47308 : v15_submission.csv \u49373 \u49457 \u46120 ")}